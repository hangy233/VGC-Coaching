{
  "name": "vgcmcp",
  "version": "2.0.0",
  "description": "An interface made for agents to analyze Pokémon VGC teams, test them through Codex CLI battles, and improve through evidence-based reflection.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test --test-concurrency=2 tests/*.test.js showdown/*.test.mjs metrics/*.test.mjs simulation/*.test.mjs observability/*.test.mjs planning/*.test.mjs isolated/*.test.mjs workflow/*.test.mjs",
    "prebuild": "node node_modules/pokemon-showdown/build",
    "build": "tsc",
    "start": "node dist/index.js",
    "battle:session": "node --use-env-proxy showdown/session.mjs",
    "battle:cli": "node --use-env-proxy isolated/launch.mjs",
    "battle:codex:qualify": "node --use-env-proxy isolated/launch.mjs --qualify-only",
    "metrics": "node metrics/cli.mjs",
    "metrics:view": "node metrics/viewer.mjs",
    "test:metrics": "node --test metrics/*.test.mjs",
    "test:timing": "node --test observability/*.test.mjs",
    "test:isolated": "node --test --test-concurrency=2 isolated/*.test.mjs",
    "test:planning": "node --test planning/*.test.mjs tests/mcp-planning.test.js",
    "timing:fixture": "node observability/benchmark.mjs fixture",
    "timing:native": "node observability/native-benchmark.mjs",
    "timing:benchmark": "node observability/benchmark.mjs",
    "timing:analyze": "node observability/analyze.mjs",
    "update-data": "npm install @pkmn/dex@latest @pkmn/data@latest @pkmn/stats@latest @smogon/calc@latest && npm run build",
    "test:showdown": "node --test showdown/*.test.mjs",
    "test:all": "npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/stats": "^0.4.0",
    "@smogon/calc": "^0.12.0",
    "pokemon-showdown": "https://codeload.github.com/smogon/pokemon-showdown/tar.gz/a5df8274e85b0889bf2a9b3422a08b39732374fc",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
